rules_version = '2';

// Portal CAF (CCLX): regras de segurança.
// A privacidade é imposta aqui, não no ecrã.
//
// Perfis: master, caf, tesoureiro, leitura.
// Níveis: publico (0), privado (1), confidencial (2).
// Os perfis vivem em /users/{email}. Os Master estão fixos nesta lista.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identidade ----------
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isMaster() {
      return signedIn() && myEmail() in [
        'tesouraria@cclx.pt',
        'ricardoribeiro9@gmail.com',
        'ricardoribeiro9@googlemail.com'
      ];
    }
    function profilePath() { return /databases/$(database)/documents/users/$(myEmail()); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function profile() { return get(profilePath()).data; }
    function isActive() { return isMaster() || (hasProfile() && profile().ativo == true); }
    function papel() { return isMaster() ? 'master' : profile().papel; }
    function hasRole(roles) { return isActive() && papel() in roles; }

    function nivelNum(n) { return n == 'confidencial' ? 2 : (n == 'privado' ? 1 : 0); }
    function myNivel() { return isMaster() ? 2 : nivelNum(profile().nivel); }
    function allScope() { return isMaster() || profile().comunidades.hasAny(['*']); }
    function inScope(c) { return allScope() || profile().comunidades.hasAny([c]); }

    // Quem pode alterar dados importados: só master e CAF (a importação normal é automática, pelo servidor).
    // O tesoureiro só consulta a sua comunidade.
    function canWriteCommunity(c) {
      return hasRole(['master', 'caf']) && inScope(c);
    }
    // Meses fechados só podem ser alterados pelo master.
    function periodOpen(p) {
      return isMaster()
        || !exists(/databases/$(database)/documents/fechos/$(p))
        || get(/databases/$(database)/documents/fechos/$(p)).data.estado != 'fechado';
    }

    // ---------- utilizadores ----------
    match /users/{email} {
      allow read: if isMaster() || hasRole(['caf']) || (signedIn() && myEmail() == email);
      allow write: if isMaster();
    }

    // ---------- entidades (configuração): só master e CAF alteram ----------
    // Apagar só é permitido na aplicação quando a entidade não tem dados; caso contrário desativa-se (ativo = false).
    match /comunidades/{id} { allow read: if isActive(); allow write: if hasRole(['master', 'caf']); }
    match /contas/{id}      { allow read: if hasRole(['master', 'caf']); allow write: if hasRole(['master', 'caf']); }
    match /categorias/{id}  { allow read: if isActive(); allow write: if hasRole(['master', 'caf']); }
    // Dimensões do plano financeiro: centros de custo, projetos, fornecedores, contas analíticas.
    match /dimensoes/{id}   { allow read: if isActive(); allow write: if hasRole(['master', 'caf']); }
    // Regras de classificação dos extratos (texto do banco → categoria, fornecedor, centro de custo).
    match /regras_banco/{id} { allow read: if isActive(); allow write: if hasRole(['master', 'caf']); }

    // ---------- dados de origem (Jotform), em lotes mensais ----------
    // Confidencial: com nomes, NIF, email, IBAN.
    match /lotes_conf/{id} {
      allow read: if isActive() && myNivel() >= 2 && inScope(resource.data.comunidadeId);
      allow create, update: if canWriteCommunity(request.resource.data.comunidadeId)
        && periodOpen(request.resource.data.periodo);
      allow delete: if hasRole(['master', 'caf']) && periodOpen(resource.data.periodo);
    }
    // Privado: sem dados pessoais (pseudónimos).
    match /lotes/{id} {
      allow read: if isActive() && myNivel() >= 1 && inScope(resource.data.comunidadeId);
      // Perfil Registos: só presenças (origem 'assistencia') das suas comunidades.
      allow list: if hasRole(['registos']) && resource.data.origem == 'assistencia' && inScope(resource.data.comunidadeId);
      allow get: if hasRole(['registos'])
        && (resource == null || (resource.data.origem == 'assistencia' && inScope(resource.data.comunidadeId)));
      allow create, update: if canWriteCommunity(request.resource.data.comunidadeId)
        && periodOpen(request.resource.data.periodo);
      allow create, update: if hasRole(['registos'])
        && request.resource.data.origem == 'assistencia'
        && inScope(request.resource.data.comunidadeId)
        && periodOpen(request.resource.data.periodo)
        && (resource == null || (resource.data.origem == 'assistencia' && resource.data.comunidadeId == request.resource.data.comunidadeId));
      allow delete: if hasRole(['master', 'caf']) && periodOpen(resource.data.periodo);
    }

    // ---------- bancos (contas centrais): só master e CAF ----------
    match /banco_lotes/{id} {
      allow read: if hasRole(['master', 'caf']);
      allow create, update: if hasRole(['master', 'caf']) && periodOpen(request.resource.data.periodo);
      allow delete: if hasRole(['master', 'caf']) && periodOpen(resource.data.periodo);
    }

    // ---------- custos fixos ----------
    match /custos_fixos/{id} {
      allow read: if isActive() && myNivel() >= nivelNum(resource.data.nivel) && inScope(resource.data.comunidadeId);
      allow write: if hasRole(['master', 'caf']);
    }

    // ---------- resumos calculados ----------
    match /resumos/{id} {
      allow read: if isActive() && myNivel() >= 1 && inScope(resource.data.comunidadeId);
      allow write: if hasRole(['master', 'caf']);
    }
    // Página pública sem login: só a visão do site CCLX (consolidado).
    match /publico/{id} {
      allow read: if true;
      allow write: if hasRole(['master', 'caf']);
    }
    // Contas públicas por comunidade (sites): só com login.
    match /publico_sites/{id} {
      allow read: if isActive();
      allow write: if hasRole(['master', 'caf']);
    }

    // ---------- orçamento, fechos ----------
    match /orcamentos/{id} {
      allow read: if isActive() && myNivel() >= 1;
      allow write: if hasRole(['master', 'caf']);
    }
    match /orcamentos_versoes/{id} {
      allow read: if isActive() && myNivel() >= 1;
      allow create: if hasRole(['master', 'caf']);
    }
    match /fechos/{periodo} {
      allow read: if isActive();
      allow write: if hasRole(['master', 'caf']);
    }
    // Fotografia dos dados de cada mês fechado, por comunidade (mesma visibilidade dos resumos).
    match /fotos_fecho/{id} {
      allow read: if isActive() && myNivel() >= 1 && inScope(resource.data.comunidadeId);
      allow write: if hasRole(['master', 'caf']);
    }

    // ---------- configuração geral (ex.: tipo de evento que conta como celebração de domingo) ----------
    match /config/{id} {
      allow read: if isActive();
      allow write: if isMaster();
    }

    // Interruptor do registo de bugs e melhorias: Master e CAF ligam e desligam (soma-se à regra de config acima).
    // O "Analisar agora" e os campos da automação ficam só para o Master (regra de config acima).
    match /config/pedidos {
      allow write: if hasRole(['caf'])
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['ativo', 'alteradoPor', 'alteradoEm']);
    }

    // ---------- bugs e melhorias (registados no rodapé de cada ecrã) ----------
    // Qualquer utilizador ativo regista, em seu nome, como "novo", se o registo estiver ligado.
    // Lê os seus; Master e CAF leem todos, mudam estado, prioridade e nota, e apagam.
    function registoPedidosLigado() {
      return !exists(/databases/$(database)/documents/config/pedidos)
        || get(/databases/$(database)/documents/config/pedidos).data.ativo != false;
    }
    match /pedidos/{id} {
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['tipo', 'titulo', 'descricao', 'ecra', 'ecraNome', 'caminho', 'estado', 'criadoPor', 'criadoEm'])
        && request.resource.data.criadoPor == myEmail()
        && request.resource.data.estado == 'novo'
        && request.resource.data.tipo in ['bug', 'melhoria']
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 120
        && request.resource.data.descricao is string && request.resource.data.descricao.size() <= 4000
        && registoPedidosLigado();
      allow read: if hasRole(['master', 'caf']) || (isActive() && resource.data.criadoPor == myEmail());
      allow update: if hasRole(['master', 'caf'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'prioridade', 'nota', 'atualizadoPor', 'atualizadoEm']);
      // Só o Master aprova ou rejeita o plano da automação e pede nova análise.
      // O plano e o PR são escritos pela automação (conta de serviço, fora destas regras).
      allow update: if isMaster()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['planoEstado', 'planoDecididoPor', 'planoDecididoEm', 'analisarAgoraEm'])
        && (!('planoEstado' in request.resource.data.diff(resource.data).affectedKeys())
            || (resource.data.planoEstado == 'proposto' && request.resource.data.planoEstado in ['aprovado', 'rejeitado']));
      allow delete: if hasRole(['master', 'caf']);
    }

    // ---------- exceções de assistência (domingos sem assistência esperada) ----------
    match /assistencia_excecoes/{id} {
      allow read: if isActive();
      allow write: if hasRole(['master', 'caf']);
    }

    // ---------- auditoria: só acrescentar ----------
    match /auditoria/{id} {
      allow read: if hasRole(['master', 'caf']);
      allow create: if isActive() && request.resource.data.quem == myEmail();
    }

    // ---------- segredos: chave da API Jotform, só master ----------
    match /segredos/{id} {
      allow read, write: if isMaster();
    }

    // ---------- estado da sincronização (escrito pelo servidor e pela sincronização forçada do Master) ----------
    match /estado/{id} {
      allow read: if isActive();
      allow write: if isMaster();
    }
  }
}
